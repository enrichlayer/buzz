[Unit]
Description=Buzz internet pilot
Requires=buzz-relay-pilot-postgres.service buzz-relay-pilot-redis.service
After=buzz-relay-pilot-postgres.service buzz-relay-pilot-redis.service
StartLimitIntervalSec=300
StartLimitBurst=5

[Container]
ContainerName=buzz-relay-pilot
Image={{ buzz_pilot_image }}
Pull=never
Network=buzz-relay-pilot.network
EnvironmentFile=/etc/buzz-relay-pilot/runtime.env
# Only cloudflared on this host can reach the origin. No database/health/metrics ports.
PublishPort=127.0.0.1:{{ buzz_pilot_http_port }}:3000
Volume=buzz-relay-pilot-git.volume:/data/git:U
PodmanArgs=--memory=2g --cpus=2 --pids-limit=512
HealthCmd=curl --fail --silent --max-time 5 http://127.0.0.1:8080/_readiness
HealthInterval=10s
HealthRetries=12
HealthStartPeriod=60s
StopTimeout=60

[Service]
Restart=on-failure
RestartSec=10
TimeoutStartSec=180
TimeoutStopSec=90

[Install]
WantedBy=multi-user.target
