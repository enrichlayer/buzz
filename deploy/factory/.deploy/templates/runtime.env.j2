BUZZ_BIND_ADDR=0.0.0.0:3000
BUZZ_HEALTH_PORT=8080
BUZZ_METRICS_PORT=9102
RELAY_URL=wss://{{ buzz_pilot_hostname }}
BUZZ_MEDIA_BASE_URL=https://{{ buzz_pilot_hostname }}/media
BUZZ_CORS_ORIGINS=https://{{ buzz_pilot_hostname }}
BUZZ_REQUIRE_AUTH_TOKEN=true
BUZZ_REQUIRE_RELAY_MEMBERSHIP=true
BUZZ_ALLOW_NIP_OA_AUTH=true
RELAY_OWNER_PUBKEY={{ buzz_pilot_runtime['owner-public-key'] }}
BUZZ_RELAY_PRIVATE_KEY={{ buzz_pilot_runtime['relay-private-key'] }}
BUZZ_GIT_HOOK_HMAC_SECRET={{ buzz_pilot_runtime['git-hook-secret'] }}
DATABASE_URL=postgres://buzz:{{ buzz_pilot_runtime['postgres-password'] }}@buzz-relay-pilot-postgres:5432/buzz
REDIS_URL=redis://:{{ buzz_pilot_runtime['redis-password'] }}@buzz-relay-pilot-redis:6379
BUZZ_S3_ENDPOINT={{ buzz_pilot_media['endpoint'] }}
BUZZ_S3_ACCESS_KEY={{ buzz_pilot_media['access-key-id'] }}
BUZZ_S3_SECRET_KEY={{ buzz_pilot_media['secret-access-key'] }}
BUZZ_S3_BUCKET=buzz-pilot-media
BUZZ_S3_REGION=auto
BUZZ_S3_ADDRESSING_STYLE=path
BUZZ_GIT_REPO_PATH=/data/git
BUZZ_AUTO_MIGRATE=true
BUZZ_GIT_CONFORMANCE_PROBE=true
BUZZ_PUSH_ENABLED=false
BUZZ_SERVE_GIT_WEB_GUI=true
RUST_LOG=buzz_relay=info,buzz_db=info,buzz_auth=info
